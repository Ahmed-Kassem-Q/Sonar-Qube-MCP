{
  "name": "sonarqube-mcp",
  "version": "0.1.0",
  "description": "Production-ready Model Context Protocol (MCP) server that connects Claude Code to SonarQube / SonarCloud for issue triage, quality-gate checks, and guided fix workflows.",
  "keywords": [
    "mcp",
    "sonarqube",
    "sonarcloud",
    "claude",
    "claude-code",
    "static-analysis"
  ],
  "license": "MIT",
  "author": "Alqemam Engineering",
  "type": "module",
  "engines": {
    "node": ">=20.6"
  },
  "bin": {
    "sonarqube-mcp": "dist/server.js"
  },
  "main": "dist/server.js",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepare": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.0"
  }
}
