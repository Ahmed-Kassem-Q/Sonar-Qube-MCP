# =============================================================================
# sonarqube-mcp configuration
#
# Copy this file to `.env` in this directory (mcp/sonarqube-mcp/.env) and fill
# in real values. The server reads it at startup, whether it is launched by
# Claude Code from the repo root or by hand from this directory.
#
# Real environment variables take precedence over anything set here.
# Never commit a real .env file — it is already git-ignored.
#
# Only SONARQUBE_URL and SONARQUBE_TOKEN need changing; the rest have working
# defaults.
# =============================================================================

# --- SonarQube / SonarCloud connection ---------------------------------------

# Base URL of your SonarQube server (self-hosted) or https://sonarcloud.io.
# For an internal server, ask a teammate — the URL is deliberately not
# committed anywhere in this repository.
SONARQUBE_URL=https://sonarcloud.io

# Preferred auth: a SonarQube/SonarCloud user token (Account > Security > Generate Token)
SONARQUBE_TOKEN=squ_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Alternative auth (only used if SONARQUBE_TOKEN is not set). Not recommended.
# SONARQUBE_USERNAME=
# SONARQUBE_PASSWORD=

# Required only when talking to SonarCloud with an organization-scoped token
SONARQUBE_ORGANIZATION=

# --- HTTP client behavior ----------------------------------------------------

SONARQUBE_TIMEOUT_SECONDS=30
SONARQUBE_MAX_RETRIES=3
SONARQUBE_RETRY_BACKOFF_SECONDS=0.5
SONARQUBE_PAGE_SIZE=100
SONARQUBE_VERIFY_SSL=true

# --- Repository access tools (read_file / write_file / list_files / ...) ----

# Absolute or relative path Claude Code is allowed to read/write through the
# repository tools. Defaults to the current working directory the server is
# started from, which under Claude Code is the project root — so leave this
# unset there and the tools sandbox to whichever checkout you opened.
MCP_REPO_ROOT=.
MCP_MAX_READ_FILE_BYTES=2000000
MCP_MAX_WRITE_FILE_BYTES=2000000

# --- Logging ------------------------------------------------------------------

# One of DEBUG, INFO, WARNING, ERROR, CRITICAL
MCP_LOG_LEVEL=INFO
