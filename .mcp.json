{
  "mcpServers": {
    "sonarqube": {
      "command": "node",
      "args": ["mcp/sonarqube-mcp/dist/server.js"],
      "env": {
        "SONARQUBE_URL": "${SONARQUBE_URL:-https://gsonar.alqemam.com}",
        "SONARQUBE_TOKEN": "${SONARQUBE_TOKEN}",
        "SONARQUBE_VERIFY_SSL": "${SONARQUBE_VERIFY_SSL:-true}",
        "MCP_LOG_LEVEL": "${MCP_LOG_LEVEL:-INFO}"
      }
    }
  }
}
